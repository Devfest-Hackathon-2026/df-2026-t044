<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Yobareta" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Universal window background for cold starts (API 30 and older devices, and pre-Compose frame) -->
        <item name="android:windowBackground">@drawable/splash_background</item>

        <!-- Android 12+ (API 31+) native splash screen API -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_splash_logo</item>
    </style>
</resources>
